  "diagram_type": "architecture",
  "meta": {
    "title": "Return of Funds — End-to-End Architecture (MSS → PayIn → MoneyOut → PPI)",
    "quality_profile": "showcase",
    "output": "payouts/return-of-funds/diagrams/rof-end-to-end.architecture.html",
    "viewBox": [
      1200,
      900
    ],
    "views": [
      {
        "id": "candidate-path",
        "label": "1. Candidate round-trip",
        "focus": [
          "statements",
          "unalloc_db",
          "unalloc_lambda",
          "check_q",
          "payin",
          "outcome_q"
        ],
        "note": "Settlement Services nominates unallocated statement credits; PayIn answers on a MoneyOut-owned FIFO queue."
      },
      {
        "id": "create-submit",
        "label": "2. Create and submit",
        "focus": [
          "rof_lambda",
          "cron",
          "mo_api",
          "mo_db",
          "orch_q"
        ],
        "note": "The processor Lambda creates the return via the API; every 15 minutes it asks the API to submit pending returns to PPI."
      },
      {
        "id": "ppi-path",
        "label": "3. PPI pays it out",
        "focus": [
          "orch_q",
          "orch_lambda",
          "instr_lambda",
          "bank"
        ],
        "note": "PPI treats OriginInternalType ReturnOfFund exactly like a Refund: same provider list, same Nedbank retry and FTI matching."
      },
      {
        "id": "status-path",
        "label": "4. Status back to MoneyOut",
        "focus": [
          "bank",
          "ppi_status_lambda",
          "topic",
          "mo_status_q",
          "mo_status_lambda",
          "mo_api"
        ],
        "note": "PPI publishes credit-push status; the SNS filter lets ReturnOfFund through; the status Lambda posts it to the Returns API."
      },
      {
        "id": "payshap-path",
        "label": "5. PayShap direct call",
        "focus": [
          "payshap",
          "mo_api",
          "mo_db"
        ],
        "note": "Agreed: Special Projects calls CreateReturnOfFunds directly with no CandidateId. Tsepo's drawing still shows it on the outcome queue."
      }
    ]
  },
