  "cards": [
    {
      "dot": "rose",
      "title": "No candidate ↔ return link",
      "items": [
        "ReturnsOfFunds has no ReturnOfFundCandidateId column",
        "CreateReturnRequest carries no CandidateId either",
        "The SLA tie-back has nothing to join on yet"
      ]
    },
    {
      "dot": "amber",
      "title": "Two transaction columns",
      "items": [
        "OriginTransactionId is set on create (unique index)",
        "TransactionId backs the Transaction navigation and is never set",
        "So Include(Transaction) is null in the pending job"
      ]
    },
    {
      "dot": "cyan",
      "title": "Migrations",
      "items": [
        "EF migrations + standalone SQL scripts live in MoneyOut.Data",
        "Run one or the other, never both",
        "MSS reads the same table; MoneyOut owns its schema"
      ]
    }
  ]
