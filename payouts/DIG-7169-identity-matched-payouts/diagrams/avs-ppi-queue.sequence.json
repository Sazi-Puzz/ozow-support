  "cards": [
    {
      "dot": "cyan",
      "title": "What the instruction carries",
      "items": [
        "The credit account number is decrypted here, per payout, from the verification-time wrapped key",
        "IdentityNumber is forwarded only when the payout is pay-to-ID — an ID with no account number",
        "An AVS payout therefore reaches PPI as an ordinary account credit push, with no identity number"
      ]
    },
    {
      "dot": "violet",
      "title": "Guards around the send",
      "items": [
        "A distributed lock on pp_{payoutId} makes the queueing single-flight",
        "Merchant, bank-group features and the debit source account are read from MoneyOut before the command is built",
        "SQS send is retried per PPI settings; a failed send leaves the payout Awaiting Submission for the next sweep"
      ]
    },
    {
      "dot": "amber",
      "title": "Identity number at rest",
      "items": [
        "The ID is KMS-encrypted at request time with PPI's account key and is never re-encrypted on the wire",
        "PPI stores what arrives and decrypts at point of use for TymeBank pay-to-ID and the statement markup file",
        "The logged command is redacted, so the ciphertext never lands in application logs"
      ]
    }
  ]
