  "cards": [
    {
      "dot": "emerald",
      "title": "Continue outcomes",
      "items": [
        "MATCH continues; a TECHNICAL_FAILURE continues only when the merchant allows bypassing AVS responses",
        "NotEligible and GloballyBypassed are audited as BYPASSED / Continue, so the dashboard and CSV show an outcome",
        "Merchant site or payout settings that cannot be resolved mean AVS does not apply — warn and carry on"
      ]
    },
    {
      "dot": "rose",
      "title": "Cancel outcomes and sub-status",
      "items": [
        "NO_MATCH, or TECHNICAL_FAILURE for a strict merchant: Verification_Failed",
        "Identity number missing or undecryptable: Verification_Failed or Verification_IdentityNumberDecryptionFailed",
        "Any unhandled AVS error: Verification_AvsLookupFailed"
      ]
    }
  ]
