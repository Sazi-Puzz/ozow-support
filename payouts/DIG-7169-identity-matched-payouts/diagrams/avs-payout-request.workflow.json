          "merchant",
          "validators",
          "encrypt",
          "payout",
          "eligibility",
          "avsrow"
        ],
        "note": "An AVS merchant supplying an account number, identity type and account type gets an AVS row at request time."
      },
      {
        "id": "skipped",
        "label": "Never reaches AVS",
        "focus": [
          "validators",
          "reject",
          "paytoid"
        ],
        "note": "Pay-to-ID intent skips AVS entirely; a missing AVS field is rejected before the payout is created."
      },
      {
        "id": "degraded",
        "label": "Eligibility lookup fails",
        "focus": [
          "eligibility",
          "eligerror",
          "avsrow",
          "verifyreq"
        ],
        "note": "A bypass-table or cache failure is logged and treated as eligible, so the AVS data is still captured."
      }
    ]
