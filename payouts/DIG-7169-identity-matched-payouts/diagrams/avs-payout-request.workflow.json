  "cards": [
    {
      "dot": "cyan",
      "title": "What request time decides",
      "items": [
        "The identity number is KMS-encrypted once, with PPI's account key, and is never stored in plaintext",
        "An AVS row is written only when the merchant is eligible and the request carries AccountType and IdentityType",
        "Pay-to-ID (ID with no account number) is a different product and is excluded from AVS"
      ]
    },
    {
      "dot": "amber",
      "title": "Deliberate fail-open",
      "items": [
        "An eligibility lookup failure no longer fails the request; it warns and captures the AVS data anyway",
        "Verification re-evaluates eligibility, so the final AVS decision is never taken here",
        "AccountType lives only on the request and the AVS row — the Payout row cannot supply it later"
      ]
    }
  ]
