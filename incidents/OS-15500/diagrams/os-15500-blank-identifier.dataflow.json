  "cards": [
    {
      "dot": "rose",
      "title": "The value is not ours",
      "items": [
        "MoneyOut assigns CardMerchantIdentifier straight from the inbound DTO with no transform",
        "That assignment has not changed since 2025-09-11, so the empty string is produced upstream",
        "The producing service is still unidentified and is the one open item from the investigation"
      ]
    },
    {
      "dot": "amber",
      "title": "Two changes, months apart",
      "items": [
        "2026-03-17 replaced a merchant allowlist with a bare null check, creating the latent flaw",
        "2026-08-04 the feed began sending empty strings, which turned the flaw into daily loss",
        "Neither change on its own would have lost a cent"
      ]
    },
    {
      "dot": "orange",
      "title": "Detection was the real gap",
      "items": [
        "The refund API answered 200 and APM recorded the trace as healthy",
        "No monitor watched the skip log, and none watched completed refunds with no float id",
        "Bank reconciliation caught it, which is weeks of exposure by design"
      ]
    }
  ]
